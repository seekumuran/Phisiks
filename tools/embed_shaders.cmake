# Embeds every engine/shaders/*.glsl file as a C++ raw string literal.
# Output: one `{ "file.glsl", R"PHISIKS_GLSL(...)PHISIKS_GLSL" ... },` entry per file, included by
# engine/src/render/EmbeddedShaders.cpp. Long files are split into adjacent literals
# (MSVC limits a single string literal to ~16 KB).
#   cmake -DSHADER_DIR=<dir> -DOUTPUT=<file> -P embed_shaders.cmake

file(GLOB shaders "${SHADER_DIR}/*.glsl")
list(SORT shaders)
set(chunkSize 4000)
set(content "// Generated by tools/embed_shaders.cmake. Do not edit.\n")
foreach(path ${shaders})
    get_filename_component(name "${path}" NAME)
    file(READ "${path}" text)
    string(REPLACE "\r" "" text "${text}")
    string(FIND "${text}" ")PHISIKS_GLSL" bad)
    if(NOT bad EQUAL -1)
        message(FATAL_ERROR "${name} contains the raw-string delimiter")
    endif()
    string(APPEND content "{ \"${name}\",\n")
    string(LENGTH "${text}" length)
    set(offset 0)
    while(offset LESS length)
        string(SUBSTRING "${text}" ${offset} ${chunkSize} chunk)
        string(APPEND content "R\"PHISIKS_GLSL(${chunk})PHISIKS_GLSL\"\n")
        math(EXPR offset "${offset} + ${chunkSize}")
    endwhile()
    if(length EQUAL 0)
        string(APPEND content "\"\"\n")
    endif()
    string(APPEND content "},\n")
endforeach()

# Only touch the output when it changed (avoids needless rebuilds).
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" previous)
    if(previous STREQUAL content)
        return()
    endif()
endif()
file(WRITE "${OUTPUT}" "${content}")
