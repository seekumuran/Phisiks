# ctest SdkConsumer (cmake -P): installs the SDK component of the build into WORK/sdk, copies the
# consumer example out of the source tree into WORK/src, configures it against the installed
# package only (CMAKE_PREFIX_PATH = WORK/sdk), builds it and runs `sdk_consumer --headless`.
#   -DBUILD_DIR= -DCONFIG= -DWORK= -DSOURCE= -DGENERATOR= [-DPLATFORM=] [-DC_COMPILER= -DCXX_COMPILER=]
cmake_minimum_required(VERSION 3.25)
foreach(v BUILD_DIR CONFIG WORK SOURCE GENERATOR)
    if(NOT DEFINED ${v} OR "${${v}}" STREQUAL "")
        message(FATAL_ERROR "test_sdk_consumer: -D${v}= is required")
    endif()
endforeach()
file(REMOVE_RECURSE ${WORK})
file(MAKE_DIRECTORY ${WORK})

set(ENV{PHISIKS_LOCAL_INSTALL} 1)   # a test install (allowed on development toolchains)
execute_process(COMMAND ${CMAKE_COMMAND} --install ${BUILD_DIR} --config ${CONFIG} --prefix ${WORK}/sdk --component sdk
                RESULT_VARIABLE r OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT r EQUAL 0)
    message(FATAL_ERROR "SDK install failed (${r}):\n${out}\n${err}")
endif()
foreach(f lib/cmake/phisiks/phisiks-config.cmake lib/cmake/phisiks/phisiks-config-version.cmake lib/cmake/phisiks/phisiks-targets.cmake
          include/Phisiks/Version.h include/Phisiks/Scene/Scene.h include/PhisiksEditor/EditorApp.h include/glm/vec3.hpp include/entt/entt.hpp
          include/imgui/imgui.h share/phisiks/LICENSE share/phisiks/SDK.md share/phisiks/BUILD_INFO.txt)
    if(NOT EXISTS ${WORK}/sdk/${f})
        message(FATAL_ERROR "SDK install is missing ${f}")
    endif()
endforeach()
# the installed targets must not point into the source or build tree
file(GLOB target_files ${WORK}/sdk/lib/cmake/phisiks/*.cmake)
get_filename_component(source_root ${SOURCE}/../.. ABSOLUTE)
foreach(f ${target_files})
    file(READ ${f} text)
    string(FIND "${text}" "${source_root}" at)
    if(NOT at EQUAL -1)
        message(FATAL_ERROR "installed package file ${f} refers to the source tree ${source_root}")
    endif()
    string(FIND "${text}" "${BUILD_DIR}" at)
    if(NOT at EQUAL -1)
        message(FATAL_ERROR "installed package file ${f} refers to the build tree ${BUILD_DIR}")
    endif()
endforeach()

file(COPY ${SOURCE}/ DESTINATION ${WORK}/src)
set(configure ${CMAKE_COMMAND} -S ${WORK}/src -B ${WORK}/build -G ${GENERATOR} -DCMAKE_PREFIX_PATH=${WORK}/sdk -DCMAKE_BUILD_TYPE=${CONFIG})
if(PLATFORM)
    list(APPEND configure -A ${PLATFORM})
endif()
if(C_COMPILER AND NOT GENERATOR MATCHES "Visual Studio")
    list(APPEND configure -DCMAKE_C_COMPILER=${C_COMPILER} -DCMAKE_CXX_COMPILER=${CXX_COMPILER})
endif()
execute_process(COMMAND ${configure} RESULT_VARIABLE r OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT r EQUAL 0)
    message(FATAL_ERROR "consumer configure failed (${r}):\n${out}\n${err}")
endif()
execute_process(COMMAND ${CMAKE_COMMAND} --build ${WORK}/build --config ${CONFIG} --parallel RESULT_VARIABLE r OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT r EQUAL 0)
    message(FATAL_ERROR "consumer build failed (${r}):\n${out}\n${err}")
endif()
find_program(consumer NAMES sdk_consumer PATHS ${WORK}/build/${CONFIG} ${WORK}/build NO_DEFAULT_PATH)
if(NOT consumer)
    message(FATAL_ERROR "sdk_consumer was not built")
endif()
execute_process(COMMAND ${consumer} --headless WORKING_DIRECTORY ${WORK} RESULT_VARIABLE r OUTPUT_VARIABLE out ERROR_VARIABLE err)
message(STATUS "${out}")
if(NOT r EQUAL 0 OR NOT out MATCHES "PHISIKS SDK consumer: OK")
    message(FATAL_ERROR "sdk_consumer --headless failed (${r}):\n${out}\n${err}")
endif()
message(STATUS "SDK consumer: installed, configured against the package, built and run")
