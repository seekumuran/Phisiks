# ctest: Showcase05_Vision --headless --export-vision must write aligned vision passes, the camera
# table, the class table and LiDAR sweeps (cmake -DEXE=<exe> -DWORK=<dir> -P test_vision_export.cmake).
file(REMOVE_RECURSE ${WORK})
execute_process(COMMAND ${EXE} --headless --export-vision --export-dir ${WORK} --export-every 30 --max-frames 150 --run-dir ${WORK}/run
                RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "export run failed (${result})")
endif()
foreach(pattern "vision/frame_*_rgb.png" "vision/frame_*_depth.pfm" "vision/frame_*_normal.png" "vision/frame_*_id.png" "vision/lidar_sweep_*.csv")
    file(GLOB found ${WORK}/${pattern})
    list(LENGTH found count)
    if(count LESS 2)
        message(FATAL_ERROR "expected exported files ${pattern}, found ${count}")
    endif()
    message(STATUS "${pattern}: ${count} files")
endforeach()
foreach(table vision/cameras.csv vision/entities.csv vision/classes.csv)
    if(NOT EXISTS ${WORK}/${table})
        message(FATAL_ERROR "missing ${table}")
    endif()
endforeach()
file(STRINGS ${WORK}/vision/classes.csv classes)
list(LENGTH classes classCount)
file(GLOB sweeps ${WORK}/vision/lidar_sweep_*.csv)
list(GET sweeps 0 sweep)
file(STRINGS ${sweep} points)
list(LENGTH points pointCount)
if(classCount LESS 50 OR pointCount LESS 4000)
    message(FATAL_ERROR "class table ${classCount} rows, first sweep ${pointCount} rows")
endif()
message(STATUS "vision export ok: ${classCount} class rows, ${pointCount} LiDAR rows in the first sweep")
