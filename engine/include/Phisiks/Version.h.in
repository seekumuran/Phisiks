#pragma once
// PHISIKS version, generated by CMake from project(Phisiks VERSION ...) in CMakeLists.txt (the only
// place the version is written). Do not edit the generated copy: <build>/generated/include/Phisiks/Version.h.

#define PHISIKS_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define PHISIKS_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define PHISIKS_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define PHISIKS_VERSION_STRING "@PROJECT_VERSION@"

// Single comparable number: major * 10000 + minor * 100 + patch (1.1.0 -> 10100).
#define PHISIKS_VERSION (PHISIKS_VERSION_MAJOR * 10000 + PHISIKS_VERSION_MINOR * 100 + PHISIKS_VERSION_PATCH)
